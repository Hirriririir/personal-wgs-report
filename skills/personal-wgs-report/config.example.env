# ===== personal-wgs-report 配置 =====
# init_workdir.sh 会把它复制成 <工作目录>/config.env；只改那一份。
# 格式：KEY=VALUE，值里有空格要加引号；# 后面是注释。

# 样本名：只用字母、数字、下划线；会出现在所有输出文件名里（不要用真名）
SAMPLE=me

# 性别：auto（按 X/Y 染色体深度推断）/ male / female
SEX=auto

# 原始数据：双端 FASTQ（.fq.gz / .fastq.gz）。测序公司拆成多对（多条泳道）时全部列出，
# 用英文逗号分隔，R1 与 R2 按顺序一一对应。放在工作目录外也可以（容器会只读挂载这些目录）。
FASTQ_R1=/data/me/me_1.fq.gz
FASTQ_R2=/data/me/me_2.fq.gz

# 文库名与测序平台型号：写进 BAM 的读段组；不知道就保持默认
LIBRARY=lib1
PLATFORM_MODEL=NovaSeqX

# 光学重复判定距离（像素）：图案化芯片（NovaSeq 6000 / X、HiSeq X / 4000）用 2500；
# 非图案化芯片（HiSeq 2500、NextSeq、MiSeq）用 100；华大 DNBSEQ 可用 2500
OPTICAL_DUP_PIXEL_DISTANCE=2500

# 计算资源
THREADS=32
MEM_GB=64

# GPU：auto（检测到 NVIDIA 显卡就用 Parabricks 做比对和变异检测）/ yes / no（纯 CPU）
USE_GPU=auto
# GPU 直通：toolkit（装了 nvidia-container-toolkit，推荐）/ manual（手动挂设备和驱动库）/ auto
GPU_MODE=auto

# 参考人群（1000 Genomes 超级人群：EAS 东亚 / EUR / AFR / AMR / SAS）
# 用在：纯合片段与古人类片段的对照、多基因风险评分的百分位
POP=EAS

# 容器镜像前缀。国内拉 quay.io 慢可以换成镜像站，例如 quay.nju.edu.cn/biocontainers
BIOC=quay.io/biocontainers

# 下载代理（访问 NCBI / Ensembl / GitHub / Google Cloud 慢时填，例如 http://127.0.0.1:7890）
HTTPS_PROXY=
